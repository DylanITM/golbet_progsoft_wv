@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5">
    <h1 class="display-4">⚽ Bienvenido a GolBet</h1>
    <p class="lead">
        El simulador de apuestas de fútbol donde arriesgas FutCoins, no dinero.
    </p>
    <a class="btn btn-success btn-lg" asp-controller="Matches" asp-action="Index">
        Ver partidos
    </a>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Matches" asp-action="Create" class="btn btn-success">+ Nuevo partido</a>
    }
    <!-- Para debugear-->
    <!-- <button onclick="console.log(@(User.IsInRole("Apostador") ? "true" : "false"))">En consola: Soy apostador?</button> -->
</div>
